# API keys for the build-time data & pricing refresh (3.14).
#
# Local: copy this file to `.env` (gitignored) and fill in the values.
# CI: these are GitHub Actions secrets, exposed to the data-refresh workflow
#     as environment variables of the same name.
#
# Read ONLY by the tools/fetch-*.js build scripts. The shipped app never reads
# them and makes no network call (the served page keeps connect-src 'none').

# Vantage instances API — instance specs/families (Phase B).
# Generate a key at instances-api.vantage.sh by providing an email.
# Used by tools/fetch-vantage.js.
VANTAGE_API_KEY=

# GCP Cloud Billing Catalog API — GCP pricing (Phase D).
# A Google Cloud API key with the Cloud Billing API enabled.
# Used by tools/fetch-official-gcp.js.
GCP_BILLING_API_KEY=

# AWS Price List Bulk API and Azure Retail Prices API need no key.
