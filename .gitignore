# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets — API keys for the build-time data/pricing refresh (3.14) live in a
# local .env (see .env.example); in CI they are GitHub Actions secrets. The
# shipped app never reads them — only the tools/fetch-*.js build scripts do.
# Never commit a real .env.
.env
.env.local
.env.*.local

# Node (if ever added)
node_modules/
npm-debug.log*

# Build outputs (if ever added)
dist/
build/

# Transient pricing artifacts from the official-API fetchers (Phase D). The
# fetchers write these for reconcile-data.js to consume in the same CI run; the
# merged result lands in the region files, so the raw dumps are never committed.
.refresh-cache/

# Temporary files
*.tmp
*.bak
scratchpad/

# Playwright E2E artifacts (browser binaries live outside the repo)
test-results/
playwright-report/
blob-report/
.playwright/

# StrykerJS mutation gate — sandbox + HTML report are generated, never committed
.stryker-tmp/
reports/
