{
  // Type-checking only — this project ships raw JS with no build step.
  // `tsc --noEmit` never writes output; it just reports type errors.
  //
  // Two programs, because the code runs in two places. This file is the browser side
  // (src/: DOM lib, no Node globals). tsconfig.node.json covers scripts/ and tests/
  // with checkJs on and @types/node. `npm run typecheck` runs both.
  //
  // Staged flip: `checkJs` is on for the whole program, so cross-file globals resolve.
  // A src/ file that still has errors carries `// @ts-nocheck` at its top, and
  // tests/suites/infra/ts-ratchet-test.js stops that list from growing. Each stage fixes
  // a folder and deletes its markers, until none remain.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No "WebWorker" lib: nothing type-checked here uses worker globals yet, and
    // adding it globally would mistype `self` as WorkerGlobalScope in DOM files.
    // Scope it per-file (triple-slash /// <reference lib="webworker" />) or via a
    // separate tsconfig when the worker itself comes under // @ts-check.
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/**/*.d.ts", "src/**/*.js"],
  "exclude": [
    "node_modules",
    "src/providers/**/regions",
    "src/providers/**/*-data.js",
    "js/vendor"
  ]
}
